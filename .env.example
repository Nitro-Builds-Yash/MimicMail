# ==============================================================================
# MimicMail — Environment & Run Configuration
# ==============================================================================

# Minimum and maximum rest intervals in minutes between dispatches
MIMICMAIL_MIN_INTERVAL_MINS=1.0
MIMICMAIL_MAX_INTERVAL_MINS=5.0
MIMICMAIL_DEFAULT_INTERVAL_MINS=2.0

# Human behavioral jitter enabled (adds +/- 15 to 35 seconds of natural variability)
MIMICMAIL_ENABLE_JITTER=true

# Browser profile directory (persists Zoho login cookies and session tokens)
MIMICMAIL_PROFILE_DIR="./zoho_browser_profile"

# Default subject line template (supports dynamic tags like {title}, {name})
MIMICMAIL_DEFAULT_SUBJECT="{title}"
